{
  "version": 2,
  "builds": [
    {
      "src": "serve.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/proxy/(.*)",
      "dest": "serve.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
